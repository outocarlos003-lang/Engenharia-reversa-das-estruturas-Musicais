{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "erm://schemas/analysis.schema.json",
  "title": "ERM Analysis Report",
  "type": "object",
  "required": ["schema_version", "target", "representation", "observations", "sections", "limitations"],
  "properties": {
    "schema_version": {"type": "string"},
    "target": {"type": "string"},
    "representation": {"$ref": "#/$defs/musicalRepresentation"},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "events": {"type": "array"},
    "motifs": {"type": "array"},
    "phrases": {"type": "array"},
    "sections": {"type": "array"},
    "form": {"type": "array"},
    "genre": {"type": "array"},
    "aesthetics": {"type": "object"},
    "production": {"type": "object"},
    "reconstruction": {"type": ["object", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "musicalRepresentation": {
      "type": "object",
      "required": ["rhythm", "melody", "harmony", "events", "motifs", "phrases", "sections", "form"],
      "properties": {
        "meter": {},
        "tempo": {},
        "rhythm": {"type": "object"},
        "melody": {"type": "object"},
        "harmony": {"type": "object"},
        "events": {"type": "array"},
        "motifs": {"type": "array"},
        "phrases": {"type": "array"},
        "sections": {"type": "array"},
        "form": {"type": "array"},
        "instrumentation": {"type": "object"},
        "dynamics": {"type": "object"},
        "spatial": {"type": "object"},
        "limitations": {"type": "array"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "claim", "type", "confidence", "sources", "limitations"],
      "properties": {
        "id": {"type": "string"},
        "claim": {"type": "string"},
        "value": {},
        "type": {"enum": ["measured", "inferred", "interpreted"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sources": {"type": "array"},
        "limitations": {"type": "array"}
      }
    }
  }
}
